%% Policy Pipeline: Unitree-Go2-Rough-Encoder-MLPState
flowchart LR
  classDef sensor fill:#dbeafe,stroke:#2563eb,color:#0f172a;
  classDef obs fill:#e0f2fe,stroke:#0284c7,color:#0f172a;
  classDef prep fill:#dcfce7,stroke:#16a34a,color:#0f172a;
  classDef net fill:#fef3c7,stroke:#d97706,color:#0f172a;
  classDef action fill:#fee2e2,stroke:#dc2626,color:#0f172a;
  classDef target fill:#e2e8f0,stroke:#475569,color:#0f172a;
  classDef critic fill:#f1f5f9,stroke:#64748b,color:#0f172a;

  S["Robot / command state<br/>IMU/body state, command/joystick, joint state, previous action, terrain scan"]:::sensor

  subgraph OBS[Observation groups]
    N_obs_height_scan["height_scan (187)<br/>height_scan(187)"]:::obs
    N_obs_command["command (3)<br/>command(3)"]:::obs
    N_obs_projected_gravity["projected_gravity (3)<br/>projected_gravity(3)"]:::obs
    N_obs_proprio["proprio (29)<br/>base_ang_vel(3), phase(2), joint_pos(12), joint_vel(12)"]:::obs
    N_obs_last_action["last_action (12)<br/>actions(12)"]:::obs
  end
  S --> OBS
  PRE["Observation preprocessing<br/>noise during training -> scale -> concat/group"]:::prep
  OBS --> PRE
  ENC["Observation encoder<br/>MLP [256, 128] -> latent 32<br/>inputs: height_scan, command, projected_gravity"]:::net
  PASS["Passthrough + normalizer<br/>proprio, last_action"]:::net
  CAT["Concat<br/>encoder latent + passthrough"]:::net
  PRE -->|193| ENC
  PRE -->|41| PASS
  ENC -->|32| CAT
  PASS -->|41| CAT
  ACTOR["EncoderMLPModel<br/>MLP: 512 -> 256 -> 128 -> 12<br/>activation: elu<br/>normalization on MLP path"]:::net
  CAT -->|73| ACTOR
  DIST["Gaussian distribution<br/>deterministic mean for inference"]:::net
  ACTOR -->|12| DIST
  ARAW["a_raw (12)<br/>normalized action delta<br/>not final q"]:::action
  DIST -->|12| ARAW
  APROC["JointPositionAction<br/>q_target = a_raw * scale + offset<br/>offset = default_joint_pos"]:::action
  QT["q_target (12)<br/>joint position target"]:::target
  ARAW -->|12| APROC
  APROC -->|12| QT

  subgraph CRITIC[Critic / value branch]
    COBS["critic observations<br/>critic(261)"]:::critic
    CNORM["normalization: yes"]:::critic
    CMLP["Critic: MLPModel<br/>MLP: 512 -> 256 -> 128 -> 1<br/>activation: elu"]:::critic
    V["V(s) scalar"]:::critic
    COBS -->|261| CNORM
    CNORM -->|261| CMLP
    CMLP -->|1| V
  end
  OBS -. privileged/state obs .-> COBS
