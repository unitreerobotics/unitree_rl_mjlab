<!-- R1 in the ARENA2036 shopfloor with the KUKA cell, as in robotics-lab's scene.usd (hall and cell
     keep their relative pose). The robot starts inside the KUKA cell, as in scene_kuka.xml.
     arena/ is generated by scripts/arena_usd_to_mjcf.py. -->
<mujoco model="r1_arena">
  <include file="scene_kuka.xml" />
  <include file="arena.xml" />
  <include file="euro_pallet.xml" />
  <include file="solid_block.xml" />
  <!-- far clip is zfar * statistic extent (0.8, from scene_kuka.xml): 250 * 0.8 = 200 m covers the hall -->
  <visual>
    <map zfar="250" />
  </visual>
</mujoco>
